<template compat="shopify">
{%- comment -%}
  Intended for blocks and sections that provide values for all the referenced settings.

  <div style="{%  render 'spacing-padding', settings: section.settings %}">

   Accepts:
      settings: {block.settings || section.settings}
{%- endcomment -%}

--padding-block-start: {{ settings['padding-block-start'] | default: settings.padding_block_start | default: 0 }}px; --padding-block-end:
{{- settings['padding-block-end'] | default: settings.padding_block_end | default: 0 -}}
px; --padding-inline-start:{{ settings['padding-inline-start'] | default: settings.padding_inline_start | default: 0 }}px; --padding-inline-end:
{{- settings['padding-inline-end'] | default: settings.padding_inline_end | default: 0 -}}
px;

</template>
