<template compat="shopify">
{%- doc -%}
  @param {string} children - The children of the overflow list.
  @param {string} [class] - The class that is applied on the overflow-list element.
  @param {string} [attributes] - The attributes that are applied on the overflow-list element.
  @param {number} [minimum-items] - The minimum number of items to show in the overflow list.
  @param {string} [ref] - The ref that is set on the overflow-list element.
  @param {string} [data-testid] - The data-testid attribute that is set on the overflow-list element.
  @param {string} [more-attributes] - The attributes that are applied on the more button slot.
  @param {string} [more-button-attributes] - The attributes that are applied directly on the more button element.
{%- enddoc -%}

<overflow-list
  {% if ref %}
    ref="{{ ref }}"
  {% endif %}
  {% if class %}
    class="{{ class }}"
  {% endif %}
  {% if minimum-items %}
    minimum-items="{{ minimum-items }}"
  {% endif %}
  {% if data-testid %}
    data-testid="{{ data-testid }}"
  {% endif %}
  {% if attributes %}
    {{ attributes }}
  {% endif %}
>
  <template shadowrootmode="open">
    <style>
      /* Keep the header in one row before the shadow stylesheet arrives.
         Editor replacements can create a fresh shadow root on every edit. */
      [part='list'] {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: var(--overflow-list-alignment);
        column-gap: 1rem;
        height: 100%;
        overflow: hidden;
      }
      [part='list'], [part='overflow-list'], [part='placeholder'] {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      [part='list'] { padding: var(--overflow-list-padding-block, 0) var(--overflow-list-padding-inline, 0); }
      [part='overflow'] { display: none; }
      [part='placeholder'] { visibility: hidden; width: 0; height: 0; }
      slot[name='more']:not([hidden]) { display: flex; height: 100%; align-items: center; }
      @media (max-width: 749px) {
        [part='list'] { justify-content: var(--overflow-list-alignment-mobile); }
      }
    </style>
    {{ 'overflow-list.css' | asset_url | stylesheet_tag }}

    <ul part="list">
      <slot></slot>
      <slot
        name="more"
        part="more"
        hidden
        {% if more-attributes %}
          {{ more-attributes }}
        {% endif %}
      >
        <li
          part="more"
        >
          <button
            class="button"
            type="button"
            tabindex="0"
            {% if more-button-attributes %}
              {{ more-button-attributes }}
            {% endif %}
          >
            {{ 'actions.more' | t }}
          </button>
        </li>
      </slot>
      <li
        part="placeholder"
        hidden
      ></li>
    </ul>

    <div part="overflow">
      <ul part="overflow-list">
        <slot name="overflow"></slot>
      </ul>
    </div>
{% comment %}{% endcomment %}  </template>

  {{ children }}
</overflow-list>

</template>
