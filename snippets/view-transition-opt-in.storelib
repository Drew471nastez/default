<template compat="shopify">
{% comment %}
  Opts into cross-document (MPA) view transitions and holds first paint until #MainContent
  parses, so the transition runs consistently. Emitted per-layout because assets/base.css is
  shared and can't read theme settings.

  view-transitions.js drops the blocker again whenever no transition can actually run, and
  falls back to dropping it at 1800 ms. It is gated on the same settings (snippets/scripts.liquid).
{% endcomment %}
{% unless request.design_mode %}
{% style %}
  {%- if settings.transition_to_main_product or settings.page_transition_enabled %}
    @media (prefers-reduced-motion: no-preference) {
      @view-transition {
        navigation: auto;
      }
    }
  {%- endif %}
  {%- if settings.page_transition_enabled %}
    html:active-view-transition-type(page-navigation) main.content-for-layout {
      view-transition-name: main-content;
    }
  {%- endif %}
  {%- if settings.transition_to_main_product %}
    html:active-view-transition-type(page-navigation) main.content-for-layout[data-template*='product'] {
      view-transition-name: none;
    }
  {%- endif %}
{% endstyle %}
{% if settings.transition_to_main_product or settings.page_transition_enabled %}
  <link
    rel="expect"
    href="#MainContent"
    blocking="render"
    id="view-transition-render-blocker"
  >
{% endif %}
{% endunless %}

</template>
