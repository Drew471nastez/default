<template compat="shopify">
{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-card--theme .product-card__content {
    text-align: var(--product-card-text-align);
  }

  .product-card--theme .product-title-block,
  .product-card--theme .product-title-block > * {
    font-family: var(--card-title-family);
    font-size: var(--card-title-size);
    font-weight: var(--card-title-weight);
    font-style: var(--card-title-style);
    letter-spacing: var(--card-title-tracking);
    line-height: var(--card-title-line-height);
    text-transform: var(--card-title-case);
    text-align: var(--product-card-text-align);
    max-width: 100%;
    width: 100%;
  }

  .product-card--theme .product-title-block > * {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--card-title-lines);
    overflow: hidden;
  }

  .product-card--theme product-price,
  .product-card--theme product-price .price,
  .product-card--theme product-price .compare-at-price {
    font-family: var(--card-price-family);
    font-weight: var(--card-price-weight);
    font-size: var(--card-price-size);
    text-align: var(--product-card-text-align);
  }

  .product-card--theme product-price {
    display: block;
    width: 100%;
    max-width: 100%;
    --text-align: var(--product-card-text-align);
  }

  .product-card--theme product-price [ref='priceContainer'],
  .product-card--theme product-price :is(.unit-price, .tax-note, .installments, .volume-pricing-note) {
    text-align: var(--product-card-text-align);
  }

  /* The price block's own width (often fit-content) would shrink the row and pin it to the start. */
  .product-card--theme product-price > * {
    width: 100%;
  }

  /*
    The shared corner radius rounds the whole card: its frame and its image. Inside a padded card
    the image follows the frame with a matching inner radius. A gallery's own larger radius wins.
  */
  .product-card--theme .card-gallery {
    border-radius: max(
      var(--border-radius, 0px),
      var(--theme-product-card-radius, 0px) - var(--theme-product-card-padding, 0px) - var(--theme-product-card-border-width, 0px)
    );
  }

  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card swatches-variant-picker-component overflow-list::part(list) {
    flex-wrap: wrap;
  }

  /*
    Product cards are narrow, so group content stacks on mobile. A group that
    turns "vertical on mobile" off renders without .mobile-column and keeps the
    horizontal direction it was given.
  */
  .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card):not(.product-card--theme):not(.product-card--theme *) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}

</template>
