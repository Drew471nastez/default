    "badge_sale_text_color": "{{ settings.color_palette.foreground }}",
    "page_background_color": "#ffffff",
    "popover_border_radius": 14,
    "product_corner_radius": 0,
    "variant_button_radius": 14,
    "variant_swatch_height": 34,
