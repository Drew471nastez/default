{
  "menus": {
    "main-menu": {
      "links": [
        {
          "url": "/",
          "title": "Home"
        },
        {
          "url": "/collections/best-sellters",
          "title": "Shop"
        },
        {
          "url": "/contact",
          "title": "Contact"
        },
        {
          "url": "/faq",
          "title": "About Us"
        }
      ],
      "title": "Main menu"
    }
  },
  "compat": {
    "kind": "shopify",
    "theme": "Horizon",
    "renamed": {
      "footer": "theme-footer",
      "header": "theme-header",
      "_blocks": "s_blocks"
    },
    "version": 1,
    "theme_version": "4.2.0"
  },
  "shopify": {
    "cart_type": "drawer",
    "page_width": "narrow",
    "icon_stroke": "default",
    "logo_height": 36,
    "type_case_h1": "none",
    "type_case_h2": "none",
    "type_case_h3": "none",
    "type_font_h1": "heading",
    "type_font_h2": "heading",
    "type_font_h3": "heading",
    "type_font_h4": "heading",
    "type_font_h5": "subheading",
    "type_font_h6": "subheading",
    "type_size_h1": "56",
    "type_size_h2": "48",
    "type_size_h3": "32",
    "type_size_h4": "24",
    "type_size_h5": "14",
    "type_size_h6": "12",
    "color_palette": {
      "color1": "#424242",
      "color2": "#292929",
      "background": "#ffffff",
      "foreground": "#000000"
