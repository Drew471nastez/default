        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
      },
      {
        "type": "header",
        "content": "t:content.appearance"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "t:settings.background_color",
        "placeholder": "t:settings.default",
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      },
      {
        "type": "select",
        "id": "border",
        "label": "t:settings.style",
        "options": [
          {
            "value": "none",
            "label": "t:options.none"
          },
          {
            "value": "solid",
            "label": "t:options.solid"
          }
        ],
        "default": "none",
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      },
      {
        "type": "range",
        "id": "border_width",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:settings.thickness",
        "default": 1,
        "visible_if": "{{ block.settings.card_style_source == 'custom' and block.settings.border != 'none' }}"
      },
      {
        "type": "range",
        "id": "border_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "t:settings.opacity",
        "default": 100,
        "visible_if": "{{ block.settings.card_style_source == 'custom' and block.settings.border != 'none' }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "t:settings.color",
        "placeholder": "t:settings.default",
        "visible_if": "{{ block.settings.border != 'none' }}"
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "t:settings.border_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding-inline-start",
        "label": "t:settings.left",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      },
      {
        "type": "range",
        "id": "padding-inline-end",
        "label": "t:settings.right",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
      }
    ],
    "presets": [
      {
        "name": "t:names.product_card",
        "category": "t:categories.product",
        "settings": {
          "product_card_gap": 4
        },
        "blocks": {
          "product-card-gallery": {
            "type": "_product-card-gallery",
            "settings": {
              "image_ratio": "adapt",
              "border": "none",
              "border_width": 1,
              "border_opacity": 100,
              "border_radius": 0,
              "padding_block_start": 0,
              "padding_block_end": 0,
              "padding_inline_start": 0,
              "padding_inline_end": 0
            }
          },
          "product_title": {
            "type": "product-title",
            "name": "t:names.product_title",
            "settings": {
              "width": "fit-content",
              "max_width": "normal",
              "alignment": "left",
              "type_preset": "paragraph",
              "font": "var(--font-body--family)",
              "font_size": "1rem",
