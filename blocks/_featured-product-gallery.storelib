<template compat="shopify">


{% liquid
  assign product = closest.product
%}

{% capture children %}
  {% unless product == blank %}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% stylesheet %}
  .featured-product-section .card-gallery .quick-add__button {
    position: absolute;
    inset-inline-end: var(--quick-add-offset, var(--padding-sm));
    bottom: var(--quick-add-offset, var(--padding-sm));
  }
{% endstylesheet %}



</template>

<schema>
{
  "name": "Product media",
  "settings": [
    {
      "type": "paragraph",
      "id": "para_1",
      "label": "Displays media from parent product",
      "content": "Displays media from parent product"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Auto"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "constrain_to_viewport",
      "options": [
        {
          "value": "",
          "label": "Off"
        },
        {
          "value": "contain",
          "label": "Maintain aspect ratio"
        },
        {
          "value": "cover",
          "label": "Crop to fit"
        }
      ],
      "default": "contain",
      "label": "Constrain to screen height",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    }
  ],
  "shopify": {
    "name": "t:names.product_media",
    "tag": null,
    "settings": [
      {
        "type": "paragraph",
        "content": "t:content.resource_reference_product_media"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "t:settings.aspect_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "t:options.auto"
          },
          {
            "value": "portrait",
            "label": "t:options.portrait"
          },
          {
            "value": "square",
            "label": "t:options.square"
          },
          {
            "value": "landscape",
            "label": "t:options.landscape"
          }
        ],
        "default": "adapt"
      },
      {
        "type": "select",
        "id": "constrain_to_viewport",
        "options": [
          {
            "value": "",
            "label": "t:options.off"
          },
          {
            "value": "contain",
            "label": "t:options.maintain_aspect_ratio"
          },
          {
            "value": "cover",
            "label": "t:options.crop_to_fit"
          }
        ],
        "default": "contain",
        "label": "t:settings.limit_media_to_screen_height",
        "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
      }
    ]
  }
}
</schema>
