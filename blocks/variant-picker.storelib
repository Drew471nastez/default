<template compat="shopify">


{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}
{% endunless %}



</template>

<schema>
{
  "name": "Variant picker",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Style",
      "options": [
        {
          "value": "dropdowns",
          "label": "Dropdowns"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Swatches",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "Text color",
      "placeholder": "Default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "Variant style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "default",
      "info": "Edit variant styling in theme settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "Background",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "Text",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "Borders",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "Selected variant style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "Background",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "Text",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "Borders",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Variant picker",
      "category": "t:categories.product"
    }
  ],
  "shopify": {
    "name": "t:names.product_variant_picker",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "t:content.type"
      },
      {
        "type": "select",
        "id": "variant_style",
        "label": "t:settings.style",
        "options": [
          {
            "value": "dropdowns",
            "label": "t:options.dropdowns"
          },
          {
            "value": "buttons",
            "label": "t:options.buttons"
          }
        ],
        "default": "buttons"
      },
      {
        "type": "checkbox",
        "id": "show_swatches",
        "label": "t:settings.swatches",
        "default": true
      },
      {
        "type": "header",
        "content": "t:content.appearance"
      },
      {
        "type": "color",
        "id": "option_label_text_color",
        "label": "t:settings.text_color",
        "placeholder": "t:settings.default",
        "alpha": true
      },
      {
        "type": "select",
        "id": "variant_style_class",
        "label": "t:settings.variant_button_style",
        "options": [
          {
            "value": "default",
            "label": "t:options.default"
          },
          {
            "value": "custom",
            "label": "t:options.custom"
          }
        ],
        "default": "default",
        "info": "t:info.edit_variants_in_theme_settings"
      },
      {
        "type": "color",
        "id": "custom_variant_background",
        "label": "t:settings.background",
        "default": "{{ settings.page_background_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_variant_text",
        "label": "t:settings.text",
        "default": "{{ settings.page_text_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_variant_border",
        "label": "t:settings.borders",
        "default": "{{ settings.page_text_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
      },
      {
        "type": "select",
        "id": "selected_variant_style_class",
        "label": "t:settings.selected_variant_button_style",
        "options": [
          {
            "value": "default",
            "label": "t:options.default"
          },
          {
            "value": "custom",
            "label": "t:options.custom"
          }
        ],
        "default": "default",
        "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
      },
      {
        "type": "color",
        "id": "custom_selected_variant_background",
        "label": "t:settings.background",
        "default": "{{ settings.page_text_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_selected_variant_text",
        "label": "t:settings.text",
        "default": "{{ settings.page_background_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_selected_variant_border",
        "label": "t:settings.borders",
        "default": "{{ settings.page_text_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "t:settings.alignment",
        "default": "left"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "padding-inline-start",
        "label": "t:settings.left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-inline-end",
        "label": "t:settings.right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "t:names.product_variant_picker",
        "category": "t:categories.product"
      }
    ]
  }
}
</schema>
