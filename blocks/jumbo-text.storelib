<template compat="shopify">


{% render 'jumbo-text' %}



</template>

<schema>
{
  "name": "Jumbo text",
  "settings": [
    {
      "id": "text",
      "type": "textarea",
      "label": "Text",
      "default": "Be bold."
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "0.8",
          "label": "Tight"
        },
        {
          "value": "1",
          "label": "Normal"
        },
        {
          "value": "1.2",
          "label": "Loose"
        }
      ],
      "default": "0.8"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "-0.03em",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "0.03em",
          "label": "Loose"
        }
      ],
      "default": "-0.03em"
    },
    {
      "type": "select",
      "id": "case",
      "label": "Case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "text_effect",
      "label": "Animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "reveal",
          "label": "Reveal"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "animation_repeat",
      "label": "Repeat animation",
      "default": false,
      "visible_if": "{{ block.settings.text_effect == \"blur\" or block.settings.text_effect == \"reveal\" }}"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    }
  ],
  "presets": [
    {
      "name": "Jumbo text",
      "category": "t:categories.decorative"
    }
  ],
  "shopify": {
    "name": "t:names.jumbo_text",
    "tag": null,
    "settings": [
      {
        "id": "text",
        "type": "textarea",
        "label": "t:settings.text",
        "default": "t:text_defaults.be_bold"
      },
      {
        "type": "select",
        "id": "font",
        "label": "Font family",
        "options": [
          {
            "value": "body",
            "label": "t:options.body"
          },
          {
            "value": "subheading",
            "label": "t:options.subheading"
          },
          {
            "value": "heading",
            "label": "t:options.heading"
          },
          {
            "value": "accent",
            "label": "t:options.accent"
          }
        ],
        "default": "heading"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "t:settings.alignment",
        "default": "left"
      },
      {
        "type": "select",
        "id": "line_height",
        "label": "Line spacing",
        "options": [
          {
            "value": "0.8",
            "label": "t:options.tight"
          },
          {
            "value": "1",
            "label": "t:options.normal"
          },
          {
            "value": "1.2",
            "label": "t:options.loose"
          }
        ],
        "default": "0.8"
      },
      {
        "type": "select",
        "id": "letter_spacing",
        "label": "Letter spacing",
        "options": [
          {
            "value": "-0.03em",
            "label": "t:options.tight"
          },
          {
            "value": "normal",
            "label": "t:options.normal"
          },
          {
            "value": "0.03em",
            "label": "t:options.loose"
          }
        ],
        "default": "-0.03em"
      },
      {
        "type": "select",
        "id": "case",
        "label": "Capitalization",
        "options": [
          {
            "value": "none",
            "label": "t:options.default"
          },
          {
            "value": "uppercase",
            "label": "t:options.uppercase"
          }
        ],
        "default": "none"
      },
      {
        "type": "select",
        "id": "text_effect",
        "label": "t:settings.animation",
        "options": [
          {
            "value": "none",
            "label": "t:options.none"
          },
          {
            "value": "blur",
            "label": "t:options.blur"
          },
          {
            "value": "reveal",
            "label": "t:options.reveal"
          }
        ],
        "default": "none"
      },
      {
        "type": "checkbox",
        "id": "animation_repeat",
        "label": "t:settings.animation_repeat",
        "default": false,
        "visible_if": "{{ block.settings.text_effect == \"blur\" or block.settings.text_effect == \"reveal\" }}"
      },
      {
        "type": "header",
        "content": "t:content.appearance"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Custom text color"
      }
    ],
    "presets": [
      {
        "name": "t:names.jumbo_text",
        "category": "t:categories.decorative"
      }
    ]
  }
}
</schema>
