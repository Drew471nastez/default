<template compat="shopify">


{% if closest.product == blank %}
  {% assign text = 'placeholders.product_title' | t %}
  {% assign product_title = '<p role="heading" aria-level="3">' | append: text | append: '</p>' %}
  {% render 'text', fallback_text: product_title, block: block, class: 'product-title-block' %}
{% else %}
  {% assign product_title = '<p role="heading" aria-level="3">' | append: closest.product.title | append: '</p>' %}
  <a
    class="contents user-select-text"
    ref="productTitleLink"
    href="{{ closest.product.url }}"
  >
    {% render 'text', fallback_text: product_title, block: block, class: 'product-title-block' %}
  </a>
{% endif %}



</template>

<schema>
{
  "name": "Product title",
  "settings": [
    {
      "type": "paragraph",
      "id": "para_1",
      "label": "Displays title from parent product",
      "content": "Displays title from parent product"
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
