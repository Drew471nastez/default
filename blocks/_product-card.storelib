        "unit": "%",
        "label": "t:settings.opacity",
        "default": 100,
        "visible_if": "{{ block.settings.card_style_source == 'custom' and block.settings.border != 'none' }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "t:settings.color",
        "placeholder": "t:settings.default",
        "visible_if": "{{ block.settings.border != 'none' }}"
      },
      {
