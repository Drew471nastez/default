<template compat="shopify">


{%- doc -%}
  @param {string} [product_view_context] - Context value passed through to the card snippet.
{%- enddoc -%}

{% liquid
  assign product = closest.product
-%}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card', children: children, product: product, block: block, product_view_context: product_view_context %}
{% render 'quantity-selector-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'gift-card-recipient-form-styles' %}
{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}



</template>

<schema>
{
  "name": "Product card",
  "settings": [
    {
      "type": "select",
      "id": "card_style_source",
      "label": "Card styling",
      "options": [
        {
          "value": "theme",
          "label": "Theme settings"
        },
        {
          "value": "custom",
          "label": "Custom block settings"
        }
      ],
      "default": "theme",
      "info": "Theme settings keep product cards consistent across the site. Custom keeps this block’s individual appearance."
    },
    {
      "type": "paragraph",
      "id": "para_2",
      "label": "Displays product from parent section",
      "content": "Displays product from parent section"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default",
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1,
      "visible_if": "{{ block.settings.card_style_source == 'custom' and block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Opacity",
      "default": 100,
      "visible_if": "{{ block.settings.card_style_source == 'custom' and block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "placeholder": "Default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "Left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "Right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.card_style_source == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "_product-card-group"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "price"
    },
    {
      "type": "review"
    },
    {
      "type": "sku"
    },
    {
      "type": "swatches"
    },
    {
      "type": "_product-card-gallery"
    },
    {
      "type": "product-title"
    },
    {
      "type": "custom-liquid"
    }
  ],
  "shopify": {
    "name": "t:names.product_card",
    "blocks": [
      {
        "type": "_product-card-group"
      },
      {
        "type": "text"
      },
      {
        "type": "image"
      },
      {
        "type": "buy-buttons"
      },
      {
        "type": "price"
      },
      {
        "type": "review"
      },
      {
        "type": "sku"
      },
      {
        "type": "swatches"
      },
      {
        "type": "_product-card-gallery"
      },
      {
        "type": "product-title"
      },
      {
        "type": "custom-liquid"
      },
      {
        "type": "@app"
      }
    ],
    "tag": null,
    "settings": [
      {
