<template compat="shopify">

{% render 'button', link: block.settings.link %}



</template>

<schema>
{
  "name": "Button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Style",
      "options": [
        {
          "value": "button",
          "label": "Primary"
        },
        {
          "value": "button-secondary",
          "label": "Secondary"
        },
        {
          "value": "button-unstyled",
          "label": "Link"
        },
        {
          "value": "button-custom",
          "label": "Custom"
        }
      ],
      "default": "button",
      "info": "Edit primary and secondary button styles in theme settings"
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Button colors"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "Background",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "Text",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "Borders",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "Link text color",
      "placeholder": "Default",
      "visible_if": "{{ block.settings.style_class == 'button-unstyled' }}"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Desktop width",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Mobile width",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "Button",
      "category": "t:categories.basic",
      "settings": {
        "link": "/collections/all"
      }
    }
  ],
  "shopify": {
    "name": "t:names.button",
    "tag": null,
    "settings": [
      {
        "type": "text",
        "id": "label",
        "label": "t:settings.label",
        "default": "t:text_defaults.button_label"
      },
      {
        "type": "url",
        "id": "link",
        "label": "t:settings.link"
      },
      {
        "type": "checkbox",
        "id": "open_in_new_tab",
        "label": "t:settings.open_new_tab",
        "default": false
      },
      {
        "type": "select",
        "id": "style_class",
        "label": "t:settings.style",
        "options": [
          {
            "value": "button",
            "label": "t:options.primary"
          },
          {
            "value": "button-secondary",
            "label": "t:options.secondary"
          },
          {
            "value": "button-unstyled",
            "label": "t:options.link"
          },
          {
            "value": "button-custom",
            "label": "t:options.custom"
          }
        ],
        "default": "button",
        "info": "t:info.edit_button_style_in_theme_settings"
      },
      {
        "type": "header",
        "content": "t:content.button_colors",
        "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
      },
      {
        "type": "color",
        "id": "custom_button_background",
        "label": "t:settings.background",
        "default": "{{ settings.page_text_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
      },
      {
        "type": "color",
        "id": "custom_button_text",
        "label": "t:settings.text",
        "default": "{{ settings.page_background_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
      },
      {
        "type": "color",
        "id": "custom_button_border",
        "label": "t:settings.borders",
        "default": "{{ settings.page_background_color }}",
        "alpha": true,
        "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
      },
      {
        "type": "color",
        "id": "link_text_color",
        "label": "t:settings.link_text_color",
        "placeholder": "t:settings.default",
        "visible_if": "{{ block.settings.style_class == 'button-unstyled' }}"
      },
      {
        "type": "header",
        "content": "t:content.size"
      },
      {
        "type": "select",
        "id": "width",
        "label": "t:settings.width_desktop",
        "options": [
          {
            "value": "fit-content",
            "label": "t:options.fit_content"
          },
          {
            "value": "custom",
            "label": "t:options.custom"
          }
        ],
        "default": "fit-content"
      },
      {
        "type": "range",
        "id": "custom_width",
        "label": "t:settings.custom_width",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "visible_if": "{{ block.settings.width == \"custom\" }}"
      },
      {
        "type": "select",
        "id": "width_mobile",
        "label": "t:settings.width_mobile",
        "options": [
          {
            "value": "fit-content",
            "label": "t:options.fit_content"
          },
          {
            "value": "custom",
            "label": "t:options.custom"
          }
        ],
        "default": "fit-content"
      },
      {
        "type": "range",
        "id": "custom_width_mobile",
        "label": "t:settings.custom_width",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
      }
    ],
    "presets": [
      {
        "name": "t:names.button",
        "category": "t:categories.basic",
        "settings": {
          "link": "/collections/all"
        }
      }
    ]
  }
}
</schema>
