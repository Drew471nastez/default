<template compat="shopify">


{% liquid
  assign block_settings = block.settings
  assign use_inverse_logo = false

  if section.settings.enable_transparent_header_home and template.name == 'index' and section.settings.home_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_product and template.name == 'product' and section.settings.product_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection' and section.settings.collection_inverse_logo == true
    assign use_inverse_logo = true
  endif

  assign logo_desktop = settings.logo
  if logo_desktop == blank
    assign logo_desktop = settings.logo_mobile
  endif
  assign logo_mobile = settings.logo_mobile
  if logo_mobile == blank
    assign logo_mobile = logo_desktop
  endif

  assign desktop_src = logo_desktop.src | default: logo_desktop.url
  assign mobile_src = logo_mobile.src | default: logo_mobile.url
  assign logo_mobile_distinct = false
  if settings.logo != blank and settings.logo_mobile != blank and desktop_src != blank and mobile_src != blank and desktop_src != mobile_src
    assign logo_mobile_distinct = true
  endif

  if use_inverse_logo
    assign inverse_desktop = settings.logo_inverse
    if inverse_desktop == blank
      assign inverse_desktop = logo_desktop
    endif
    assign inverse_mobile = settings.logo_inverse_mobile
    if inverse_mobile == blank
      assign inverse_mobile = settings.logo_inverse
    endif
    if inverse_mobile == blank
      assign inverse_mobile = logo_mobile
    endif

    assign inverse_desktop_src = inverse_desktop.src | default: inverse_desktop.url
    assign inverse_mobile_src = inverse_mobile.src | default: inverse_mobile.url
    assign inverse_mobile_distinct = false
    if inverse_desktop_src != blank and inverse_mobile_src != blank and inverse_desktop_src != inverse_mobile_src
      assign inverse_mobile_distinct = true
    endif
  else
    assign inverse_desktop = logo_desktop
    assign inverse_mobile = logo_mobile
  endif

  assign alt_text_fallback = 'accessibility.home_logo_alt' | t: store_name: shop.name
  assign logo_height = settings.logo_height | default: 36
  assign logo_height_mobile = settings.logo_height_mobile | default: 28

  assign logo_ratio = logo_desktop.aspect_ratio
  if logo_ratio == blank or logo_ratio <= 0
    if logo_desktop.height > 0
      assign logo_ratio = logo_desktop.width | times: 1.0 | divided_by: logo_desktop.height
    else
      assign logo_ratio = 1
    endif
  endif
  assign mobile_ratio = logo_mobile.aspect_ratio
  if mobile_ratio == blank or mobile_ratio <= 0
    if logo_mobile.height > 0
      assign mobile_ratio = logo_mobile.width | times: 1.0 | divided_by: logo_mobile.height
    else
      assign mobile_ratio = logo_ratio
    endif
  endif
  assign inverse_ratio = inverse_desktop.aspect_ratio
  if inverse_ratio == blank or inverse_ratio <= 0
    if inverse_desktop.height > 0
      assign inverse_ratio = inverse_desktop.width | times: 1.0 | divided_by: inverse_desktop.height
    else
      assign inverse_ratio = logo_ratio
    endif
  endif
  assign inverse_mobile_ratio = inverse_mobile.aspect_ratio
  if inverse_mobile_ratio == blank or inverse_mobile_ratio <= 0
    if inverse_mobile.height > 0
      assign inverse_mobile_ratio = inverse_mobile.width | times: 1.0 | divided_by: inverse_mobile.height
    else
      assign inverse_mobile_ratio = mobile_ratio
    endif
  endif
  assign slot_ratio = logo_ratio | at_least: inverse_ratio
  assign slot_ratio_mobile = mobile_ratio | at_least: inverse_mobile_ratio
  assign slot_width = logo_height | times: slot_ratio | ceil
  assign slot_width_mobile = logo_height_mobile | times: slot_ratio_mobile | ceil
%}

{% liquid
  # Logo > Logo: a picture, text, or both (text left or right of the picture).
  assign logo_style = settings.logo_style | default: 'image'
  assign logo_text = settings.logo_text | default: shop.name
  assign has_picture = false
  if logo_desktop != blank or inverse_desktop != blank or inverse_mobile != blank
    assign has_picture = true
  endif
  if logo_style == 'image_text' and has_picture == false
    assign logo_style = 'text'
  endif
%}

{% capture logo_image_desktop %}
  {% render 'image',
    image: logo_desktop,
    class: 'header-logo__image',
    height: logo_height,
    alt_text_fallback: alt_text_fallback,
    text_fallback: logo_text
  %}
{% endcapture %}
{% capture logo_image_mobile %}
  {% render 'image',
    image: logo_mobile,
    class: 'header-logo__image',
    height: logo_height_mobile,
    alt_text_fallback: alt_text_fallback,
    text_fallback: logo_text
  %}
{% endcapture %}
{% capture inverse_image_desktop %}
  {% render 'image',
    image: inverse_desktop,
    class: 'header-logo__image',
    height: logo_height,
    alt_text_fallback: alt_text_fallback,
    text_fallback: logo_text
  %}
{% endcapture %}
{% capture inverse_image_mobile %}
  {% render 'image',
    image: inverse_mobile,
    class: 'header-logo__image',
    height: logo_height_mobile,
    alt_text_fallback: alt_text_fallback,
    text_fallback: logo_text
  %}
{% endcapture %}

{% capture logo_pictures %}
  <span
    {% if use_inverse_logo %}
      class="header-logo__solid-header-image-container"
    {% endif %}
    data-testid="header-logo"
  >
    {% if logo_mobile_distinct %}
      <span class="header-logo__device header-logo__device--desktop">{{ logo_image_desktop }}</span>
      <span class="header-logo__device header-logo__device--mobile">{{ logo_image_mobile }}</span>
    {% else %}
      {{ logo_image_desktop }}
    {% endif %}
  </span>

  {% if use_inverse_logo %}
    <span
      class="header-logo__transparent-header-image-container"
      data-testid="header-logo-inverse"
    >
      {% if inverse_mobile_distinct %}
        <span class="header-logo__device header-logo__device--desktop">{{ inverse_image_desktop }}</span>
        <span class="header-logo__device header-logo__device--mobile">{{ inverse_image_mobile }}</span>
      {% else %}
        {{ inverse_image_desktop }}
      {% endif %}
    </span>
  {% endif %}
{% endcapture %}

{% comment %}
  Output all logo variants, use CSS to hide/show the appropriate one
  based on the .header[transparent] selector
{% endcomment %}
<a
  {% if template.name == 'index' and block_settings.hide_logo_on_home_page %}
    data-hidden-on-home-page
  {% endif %}
  href="{{ routes.root_url }}"
  class="size-style spacing-style header-logo{% if logo_style == 'text' %} header-logo--text{% elsif logo_style == 'image_text' %} header-logo--with-text header-logo--text-{{ settings.logo_text_position | default: 'right' }}{% endif %}"
  {% if logo_style == 'image' and has_picture %}data-image-logo{% endif %}
  {% if logo_style != 'image' %}aria-label="{{ logo_text | escape }}"{% endif %}
  style="
    {% render 'size-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --font-family: var(--font-body--family);
    --font-style: var(--font-body--style);
    --font-weight: 600;
    --header-logo-width: {{ slot_width }}px;
    --header-logo-width-mobile: {{ slot_width_mobile }}px;
    --header-logo-height: {{ logo_height }}px;
    --header-logo-height-mobile: {{ logo_height_mobile }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- case logo_style -%}
    {%- when 'text' -%}
      <span class="header-logo__text">{{ logo_text }}</span>
    {%- when 'image_text' -%}
      <span class="header-logo__mark" aria-hidden="true">{{ logo_pictures }}</span>
      <span class="header-logo__text">{{ logo_text }}</span>
    {%- else -%}
      {{ logo_pictures }}
  {%- endcase -%}
</a>

{% stylesheet %}
  .header-logo {
    display: grid;
    min-width: 0;
    max-width: 100%;
    height: 100%;
    font-size: var(--font-size--md);
    font-family: var(--font-family);
    font-weight: var(--font-weight);
    font-style: var(--font-style);
    color: var(--color-foreground);
    justify-content: center;
    align-items: center;
    text-decoration: none;

    &[data-hidden-on-home-page] {
      display: none;

      #header-component:is(
          [sticky='always']:not([data-scroll-direction='none']),
          [sticky='scroll-up'][data-scroll-direction='up']
        )
        & {
        display: grid;
      }
    }

    @media screen and (max-width: 749px) {
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      flex-shrink: 1;
    }

    &:hover {
      text-decoration: none;
    }
  }

  .header-logo[data-image-logo] {
    width: var(--header-logo-width-mobile);
    height: auto;
    justify-content: normal;

    @media screen and (min-width: 750px) {
      width: var(--header-logo-width);
    }
  }

  .header-logo > span {
    /* Both variants share a footprint; swapping them must not resize navigation. */
    grid-area: 1 / 1;
    min-width: 0;
  }

  .header-logo[data-image-logo] > span {
    height: var(--header-logo-height-mobile);

    @media screen and (min-width: 750px) {
      height: var(--header-logo-height);
    }
  }

  .header-logo__device {
    display: none;
    height: 100%;
    min-width: 0;
  }

  .header-logo__device--mobile {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .header-logo__device--mobile {
      display: none;
    }

    .header-logo__device--desktop {
      display: block;
    }
  }

  .header-logo__image {
    display: block;
    object-fit: contain;
    width: 100%;
    height: 100%;
  }

  .header-logo__solid-header-image-container {
    display: var(--header-logo-display, block);
  }

  .header-logo__transparent-header-image-container {
    display: var(--header-logo-inverse-display, none);
  }

  /* Logo > Text: font, weight and sizes come from the theme's CSS (--logo-text-*). */
  .header-logo__text {
    font-family: var(--logo-text-family, var(--font-heading--family));
    font-style: var(--logo-text-style, normal);
    font-weight: var(--logo-text-weight, 600);
    font-size: var(--logo-text-size-mobile, 18px);
    line-height: 1.1;
    letter-spacing: var(--logo-text-tracking, normal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;

    @media screen and (min-width: 750px) {
      font-size: var(--logo-text-size, 22px);
    }
  }

  .header-logo--with-text {
    display: flex;
    align-items: center;
    gap: var(--logo-text-gap, 10px);
  }

  .header-logo--text-left {
    flex-direction: row-reverse;
  }

  .header-logo__mark {
    display: grid;
    flex-shrink: 0;
    width: var(--header-logo-width-mobile);
    height: var(--header-logo-height-mobile);

    @media screen and (min-width: 750px) {
      width: var(--header-logo-width);
      height: var(--header-logo-height);
    }
  }

  .header-logo__mark > span {
    grid-area: 1 / 1;
    min-width: 0;
    height: 100%;
  }
{% endstylesheet %}



</template>

<schema>
{
  "name": "Logo",
  "settings": [
    {
      "type": "paragraph",
      "id": "para_1",
      "label": "Edit logo in theme settings",
      "content": "Edit logo in theme settings"
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "Hide logo on home page",
      "info": "Logo will remain visible when sticky header is active"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "shopify": {
    "name": "t:names.logo",
    "tag": null,
    "class": "header-logo",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:content.edit_logo_in_theme_settings"
      },
      {
        "type": "header",
        "content": "t:content.visibility"
      },
      {
        "type": "checkbox",
        "id": "hide_logo_on_home_page",
        "label": "t:settings.hide_logo_on_home_page",
        "info": "t:info.hide_logo_on_home_page_help"
      },
      {
        "type": "header",
        "content": "t:content.padding_desktop"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ]
  }
}
</schema>
