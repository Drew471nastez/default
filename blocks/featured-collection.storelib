<template compat="shopify">


<div
  class="featured-collection-block"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .featured-collection-block {
    width: 100%;
  }
{% endstylesheet %}



</template>

<schema>
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "blocks": [
    {
      "type": "collection-title"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "presets": [],
  "shopify": {
    "name": "t:names.featured_collection",
    "tag": null,
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "collection-title"
      },
      {
        "type": "text"
      },
      {
        "type": "image"
      },
      {
        "type": "button"
      },
      {
        "type": "group"
      },
      {
        "type": "spacer"
      }
    ],
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "t:settings.collection"
      }
    ],
    "presets": []
  }
}
</schema>
