[
 {
  "name": "Logo and favicon",
  "settings": [
   {
    "type": "image_picker",
    "id": "logo",
    "label": "Default logo"
   },
   {
    "type": "image_picker",
    "id": "logo_inverse",
    "label": "Inverse logo",
    "info": "Used when transparent header background is set to Inverse"
   },
   {
    "type": "range",
    "id": "logo_height",
    "label": "Desktop height",
    "min": 12,
    "max": 100,
    "step": 1,
    "unit": "px",
    "default": 36,
    "visible_if": "{{ settings.logo != blank or settings.logo_inverse != blank }}",
    "info": "Only affects header logo"
   },
   {
    "type": "range",
    "id": "logo_height_mobile",
    "label": "Mobile height",
    "min": 12,
    "max": 100,
    "step": 1,
    "unit": "px",
    "default": 28,
    "visible_if": "{{ settings.logo != blank or settings.logo_inverse != blank }}",
    "info": "Only affects header logo"
   },
   {
    "type": "image_picker",
    "id": "favicon",
    "label": "Favicon"
   }
  ]
 },
