{
  "sections": {
    "main": {
      "name": "Password",
      "type": "password",
      "settings": {
        "gap": 12,
        "section_width": "page-width",
        "align_baseline": false,
        "video_position": "cover",
        "background_color": "{{ settings.color_palette.background }}",
        "background_media": "none",
        "content_direction": "column",
        "padding_block_end": 100,
        "vertical_alignment": "center",
        "vertical_on_mobile": true,
        "padding_block_start": 100,
        "horizontal_alignment": "center",
        "background_image_position": "cover",
        "vertical_alignment_flex_direction_column": "center",
        "horizontal_alignment_flex_direction_column": "center"
      },
      "blocks": {
        "logo": {
          "type": "logo",
          "settings": {
            "font": "heading",
            "unit": "pixel",
            "inverse": false,
            "unit_mobile": "percent",
            "pixel_height": 24,
            "percent_width": 100,
            "padding_block_end": 32,
            "custom_mobile_size": false,
            "padding_inline_end": 0,
            "padding_block_start": 0,
            "pixel_height_mobile": 120,
            "padding_inline_start": 0,
            "percent_width_mobile": 80
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "case": "none",
            "font": "var(--font-body--family)",
            "text": "<h1>Opening soon</h1>",
            "wrap": "pretty",
            "width": "fit-content",
            "alignment": "left",
            "max_width": "normal",
            "background": false,
            "line_height": "normal",
            "type_preset": "h3",
            "corner_radius": 0,
            "letter_spacing": "normal",
            "background_color": "#00000026",
            "padding_block_end": 0,
            "padding_inline_end": 0,
            "padding_block_start": 0,
            "padding_inline_start": 0
          }
        },
        "text-2": {
          "type": "text",
          "settings": {
            "case": "none",
            "font": "var(--font-body--family)",
            "text": "<p>Sign up for our newsletter to be the first to know when we launch.</p>",
            "wrap": "pretty",
            "width": "fit-content",
            "alignment": "left",
            "max_width": "normal",
            "background": false,
            "line_height": "normal",
            "type_preset": "rte",
            "corner_radius": 0,
            "letter_spacing": "normal",
            "background_color": "#00000026",
            "padding_block_end": 32,
            "padding_inline_end": 0,
            "padding_block_start": 0,
            "padding_inline_start": 0
          }
        },
        "email-signup": {
          "type": "email-signup",
          "settings": {
            "label": "Sign up",
            "width": "custom",
            "input_style": "custom",
            "style_class": "button",
            "border_style": "all",
            "border_width": 1,
            "custom_width": 50,
            "display_type": "text",
            "border_radius": 14,
            "input_text_color": "{{ settings.color_palette.color1 }}",
            "input_type_preset": "paragraph",
            "integrated_button": false,
            "padding_block_end": 0,
            "button_type_preset": "paragraph",
            "input_border_color": "{{ settings.color_palette.color2 }}",
            "padding_inline_end": 0,
            "padding_block_start": 0,
            "padding_inline_start": 0,
            "input_background_color": "{{ settings.color_palette.background }}"
          }
        }
      },
      "block_order": [
        "logo",
        "text",
        "text-2",
        "email-signup"
      ]
    }
  },
  "order": [
    "main"
  ]
}
