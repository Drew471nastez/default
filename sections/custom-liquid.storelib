<template compat="shopify">


{% liquid
    render 'contrast-override', color_scheme: section.settings.theme_color_scheme, use_theme_default: true, text_color: section.settings.text_color, background_color: section.settings.background_color, section_id: section.id
%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {{ section.settings.custom_liquid }}
</div>



</template>

<schema>
{
  "type": "custom-liquid",
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code",
      "info": "Add app snippets or other code to create advanced customizations. Learn more"
    },
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme default"
        },
        {
          "value": "base",
          "label": "Page colors"
        },
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "inherit",
      "info": "Follow shared theme colors, choose a shared scheme, or select Custom colors to override this area."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom background",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text color",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid",
      "category": "t:categories.layout"
    }
  ],
  "shopify": {
    "name": "t:names.custom_liquid",
    "settings": [
      {
        "type": "liquid",
        "id": "custom_liquid",
        "label": "t:settings.custom_liquid",
        "info": "t:info.custom_liquid"
      },
      {
        "type": "select",
        "id": "theme_color_scheme",
        "label": "Color scheme",
        "options": [
          {
            "value": "inherit",
            "label": "Use theme default"
          },
          {
            "value": "base",
            "label": "Page colors"
          },
          {
            "value": "surface",
            "label": "Soft surface"
          },
          {
            "value": "inverse",
            "label": "Inverse"
          },
          {
            "value": "accent",
            "label": "Accent"
          },
          {
            "value": "custom",
            "label": "Custom colors"
          }
        ],
        "default": "inherit",
        "info": "Follow shared theme colors, choose a shared scheme, or select Custom colors to override this area."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Custom background",
        "placeholder": "t:settings.default",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Custom text color",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Content width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          },
          {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "t:names.custom_liquid",
        "category": "t:categories.layout"
      }
    ]
  }
}
</schema>
