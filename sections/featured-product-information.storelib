                "blocks": {
                  "title": {
                    "type": "product-title",
                    "name": "t:names.title",
                    "settings": {
                      "type_preset": "rte"
                    }
                  },
                  "price": {
                    "type": "price",
                    "name": "t:names.product_price",
                    "settings": {
