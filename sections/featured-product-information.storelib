          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "inherit",
        "info": "Follow the site colors, or choose your own background and text."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "placeholder": "t:settings.default",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "header",
