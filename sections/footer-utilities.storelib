<template compat="shopify">


{% liquid
    render 'contrast-override', color_scheme: section.settings.theme_color_scheme, use_theme_default: true, text_color: section.settings.text_color, background_color: section.settings.background_color, section_id: section.id
%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>
<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="utilities utilities--blocks-{{ section.blocks.size }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px;{% if section.settings.divider_color != blank %} --divider-color: {{ section.settings.divider_color }};{% endif %} --gap: {{ section.settings.gap }}px;"
    data-testid="footer-utilities"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .utilities {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap);
    text-wrap: nowrap;
    border-top: var(--border-width) solid var(--divider-color, var(--color-border));
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      justify-content: center;
      gap: var(--gap);
      align-items: center;
      text-align: start;
    }
  }

  .utilities a,
  .utilities button {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .utilities > * {
    text-align: center;

    @media screen and (min-width: 750px) {
      text-align: start;
      justify-self: start;
    }
  }

  /* Dynamic positioning based on number of blocks */
  @media screen and (min-width: 750px) {
    /* 1 block: Single column, left aligned */
    .utilities--blocks-1 {
      grid-template-columns: 1fr;
      justify-content: start;
    }

    .utilities--blocks-1 > * {
      justify-self: start;
      text-align: start;
    }

    /* 2 blocks: Two equal columns, start and end aligned */
    .utilities--blocks-2 {
      grid-template-columns: 1fr 1fr;
    }

    .utilities--blocks-2 > *:nth-child(2) {
      justify-self: end;
      text-align: end;
    }

    /* 3 blocks: Three columns (1fr auto 1fr), start/center/end aligned */
    .utilities--blocks-3 {
      grid-template-columns: 1fr auto 1fr;
    }

    .utilities--blocks-3 > *:nth-child(2) {
      justify-self: center;
      text-align: center;
    }

    .utilities--blocks-3 > *:nth-child(3) {
      justify-self: end;
      text-align: end;
    }
  }
{% endstylesheet %}



</template>

<schema>
{
  "type": "footer-utilities",
  "name": "Policies and links",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme default"
        },
        {
          "value": "base",
          "label": "Page colors"
        },
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "inherit",
      "info": "Follow shared theme colors, choose a shared scheme, or select Custom colors to override this area."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom background",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text color",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Divider thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "visible_if": "{{ section.settings.divider_thickness > 0 }}"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-list"
    },
    {
      "type": "social-links"
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Policies and links",
      "category": "t:categories.footer",
      "blocks": {
        "copyright": {
          "type": "footer-copyright"
        },
        "policy_list": {
          "type": "footer-policy-list"
        },
        "social_icons": {
          "type": "social-links"
        }
      },
      "block_order": [
        "copyright",
        "policy_list",
        "social_icons"
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "shopify": {
    "name": "t:names.policies_and_links",
    "tag": "div",
    "class": "footer-utilities",
    "max_blocks": 3,
    "enabled_on": {
