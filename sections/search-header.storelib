<template compat="shopify">


{% liquid
    render 'contrast-override', color_scheme: section.settings.theme_color_scheme, use_theme_default: true, text_color: section.settings.text_color, background_color: section.settings.background_color, section_id: section.id
%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>
<div class="section section--page-width color-custom-{{ section.id }}">
  <div
    class="spacing-style search-page__header"
    style="
      --horizontal-alignment: {{ section.settings.alignment }};
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% assign heading_text = 'content.search' | t %}

    {% if search.performed %}
      {% assign heading_text = 'content.search_results' | t %}
    {% endif %}

    {% capture heading_text %}
      <h3>{{ heading_text }}</h3>
    {% endcapture %}

    {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}
    {% content_for 'block', id: 'search', type: '_search-input' %}
  </div>
</div>



</template>

<schema>
{
  "type": "search-header",
  "name": "Search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme default"
        },
        {
          "value": "base",
          "label": "Page colors"
        },
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "inherit",
      "info": "Follow shared theme colors, choose a shared scheme, or select Custom colors to override this area."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom background",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text color",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "shopify": {
    "name": "t:names.search",
    "settings": [
      {
        "type": "select",
        "id": "alignment",
        "label": "t:settings.alignment",
        "options": [
          {
            "value": "flex-start",
            "label": "t:options.direction_start"
          },
          {
            "value": "center",
            "label": "t:options.direction_center"
          },
          {
            "value": "flex-end",
            "label": "t:options.direction_end"
          }
        ],
        "default": "flex-start"
      },
      {
        "type": "select",
        "id": "theme_color_scheme",
        "label": "Colors",
        "options": [
          {
            "value": "inherit",
            "label": "Theme"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "inherit",
        "info": "Follow the site colors, or choose your own background and text."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "placeholder": "t:settings.default",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ]
  }
}
</schema>
