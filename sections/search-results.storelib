          },
          {
            "value": "surface",
            "label": "Soft surface"
          },
          {
            "value": "inverse",
            "label": "Inverse"
          },
          {
            "value": "accent",
            "label": "Accent"
          }
        ],
        "default": "inherit",
        "info": "Shared colors are edited in Theme settings → Colors. Default keeps the existing custom colors."
