          {
            "value": "page-width",
            "label": "t:options.page"
          },
          {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "t:settings.alignment",
        "options": [
          {
            "value": "left",
            "label": "t:options.direction_start"
          },
          {
            "value": "center",
            "label": "t:options.direction_center"
          },
          {
            "value": "right",
            "label": "t:options.direction_end"
          }
        ],
        "default": "left"
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "t:settings.image_position",
        "options": [
          {
            "value": "left",
            "label": "t:options.direction_start"
          },
          {
            "value": "right",
            "label": "t:options.direction_end"
          }
        ],
        "default": "right",
        "visible_if": "{{ section.settings.layout == \"spotlight\" }}"
      },
      {
        "type": "select",
