      "default": "right",
      "visible_if": "{{ section.settings.layout == \"spotlight\" }}"
    },
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "inherit",
          "label": "Default / custom colors"
        },
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "inherit",
