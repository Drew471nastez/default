<template compat="shopify">


{% liquid
  assign section_settings = section.settings
  assign image = settings.logo
  assign image_mobile = settings.logo_mobile

  if section_settings.inverse and settings.logo_inverse
    assign image = settings.logo_inverse
  endif
  if section_settings.inverse and settings.logo_inverse_mobile
    assign image_mobile = settings.logo_inverse_mobile
  elsif section_settings.inverse and settings.logo_inverse
    assign image_mobile = settings.logo_inverse
  endif

  if image == blank
    assign image = image_mobile
  endif
  if image_mobile == blank
    assign image_mobile = image
  endif

  assign image_src = image.src | default: image.url
  assign image_mobile_src = image_mobile.src | default: image_mobile.url
  assign image_mobile_distinct = false
  if image_src != blank and image_mobile_src != blank and image_src != image_mobile_src
    assign image_mobile_distinct = true
  endif

    render 'contrast-override', color_scheme: section_settings.theme_color_scheme, use_theme_default: true, text_color: section_settings.text_color, background_color: section_settings.background_color, section_id: section.id
%}

{%- if image -%}
  {% capture logo_image %}
    {{-
      image
      | image_url: width: 3840
      | image_tag:
        width: image.width,
        widths: '240, 352, 832, 1200, 1600, 1920, 2560, 3840',
        height: image.height,
        class: 'logo-section__image logo-section__image--desktop',
        alt: shop.name,
        sizes: '(min-width: 750px) calc(var(--logo-width)), 100vw'
    -}}
    {%- if image_mobile_distinct -%}
      {{-
        image_mobile
        | image_url: width: 3840
        | image_tag:
          width: image_mobile.width,
          widths: '240, 352, 832, 1200, 1600, 1920, 2560, 3840',
          height: image_mobile.height,
          class: 'logo-section__image logo-section__image--mobile',
          alt: shop.name,
          sizes: '100vw'
      -}}
    {%- endif -%}
  {% endcapture %}
{%- endif -%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>
<div
  class="section section--{{ section_settings.section_width }} color-custom-{{ section.id }}"
>
  <div
    class="
      logo-section
      logo-section--{{ section_settings.alignment_horizontal }}
      spacing-style
    "
    style="
      {% if section_settings.unit == 'percent' %}
        --logo-width: {{ section_settings.percent_width }}%;
      {% else %}
        {% if image %}
          --logo-width: {{ image.width | times: 1.00 | divided_by: image.height | times: section_settings.pixel_height }}px;
        {% else %}
          --logo-width: {{ shop.name.size | times: 0.65 }}em;
          --logo-height: {{ section_settings.pixel_height }}px;
        {% endif %}
      {% endif %}

      {% if section_settings.custom_mobile_size %}
        {% if section_settings.unit_mobile == 'percent' %}
          --logo-width-mobile: {{ section_settings.percent_width_mobile }}%;
          --logo-height-mobile: auto;
        {% else %}
          {% if image %}
            --logo-width-mobile: {{ image.width | times: 1.00 | divided_by: image.height | times: section_settings.pixel_height_mobile }}px;
            {% else %}
              --logo-width-mobile: {{ shop.name.size | times: 0.65 }}em;
              --logo-height-mobile: {{ section_settings.pixel_height_mobile }}px;
          {% endif %}
        {% endif %}
      {% endif %}
      {% render 'spacing-style', settings: section_settings %}
    "
    {{ section.shopify_attributes }}
  >
    {% if logo_image %}
      <div class="logo-section__image-wrapper">
        {{ logo_image }}
      </div>
    {% else %}
      {% render 'jumbo-text', text: shop.name, block_settings: section.settings %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .logo-section {
    width: calc(var(--logo-width) + var(--padding-inline-start) + var(--padding-inline-end));
    max-width: 100%;
    max-height: calc(var(--logo-height, 100%) + var(--padding-block-start) + var(--padding-block-end));
    font-size: var(--logo-height);
    display: flex;

    @media screen and (max-width: 749px) {
      max-height: calc(
        var(--logo-height-mobile, var(--logo-height, 100%)) + var(--padding-block-start) + var(--padding-block-end)
      );
      font-size: var(--logo-height-mobile, var(--logo-height));
      width: calc(
        var(--logo-width-mobile, var(--logo-width)) + var(--padding-inline-start) + var(--padding-inline-end)
      );
    }
  }

  .logo-section--center {
    margin-inline: auto;
  }

  .logo-section--flex-end {
    margin-inline-start: auto;
  }

  .logo-section--flex-start {
    margin-inline-end: auto;
  }

  .logo-section__image-wrapper {
    display: flex;
    width: 100%;
    max-width: 100%;
    max-height: 100%;
  }

  .logo-section__image {
    object-fit: contain;
    width: 100%;
  }

  .logo-section__image--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .logo-section__image-wrapper:has(.logo-section__image--mobile) .logo-section__image--desktop {
      display: none;
    }

    .logo-section__image--mobile {
      display: block;
    }
  }
{% endstylesheet %}



</template>

<schema>
