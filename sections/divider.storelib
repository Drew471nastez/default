<template compat="shopify">


{% assign full_width = false %}

{% if section.settings.width_percent == 100 and section.settings.section_width == 'full-width' %}
  {% assign full_width = true %}
{% endif %}

{% liquid
    render 'contrast-override', color_scheme: section.settings.theme_color_scheme, use_theme_default: true, text_color: section.settings.text_color, background_color: section.settings.background_color, section_id: section.id
%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>

<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  data-testid="divider-{{ section.id }}"
>
  {% render 'divider', id: section.id, settings: section.settings, attributes: true, full_width: full_width %}
</div>



</template>

<schema>
{
  "type": "divider",
  "name": "Divider",
  "settings": [
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme default"
        },
        {
          "value": "base",
          "label": "Page colors"
        },
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "inherit",
      "info": "Follow shared theme colors, choose a shared scheme, or select Custom colors to override this area."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom background",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text color",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color",
      "placeholder": "Default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corner radius",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        }
      ],
      "default": "square",
      "visible_if": "{{ section.settings.thickness > 1 and section.settings.width_percent != 100 or section.settings.section_width == \"page-width\"}}"
    },
    {
      "type": "range",
      "id": "width_percent",
      "label": "Length",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment_horizontal",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.width_percent < 100 }}"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "t:categories.layout"
    }
  ],
  "shopify": {
    "name": "t:names.divider",
    "settings": [
      {
        "type": "select",
        "id": "theme_color_scheme",
        "label": "Color scheme",
        "options": [
          {
            "value": "inherit",
            "label": "Use theme default"
          },
          {
            "value": "base",
            "label": "Page colors"
          },
          {
            "value": "surface",
            "label": "Soft surface"
          },
          {
            "value": "inverse",
            "label": "Inverse"
          },
          {
            "value": "accent",
            "label": "Accent"
          },
          {
            "value": "custom",
            "label": "Custom colors"
          }
        ],
        "default": "inherit",
        "info": "Follow shared theme colors, choose a shared scheme, or select Custom colors to override this area."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Custom background",
        "placeholder": "t:settings.default",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Custom text color",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "color",
        "id": "divider_color",
        "label": "t:settings.color",
        "placeholder": "t:settings.default"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Content width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          },
          {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "full-width"
      },
      {
        "type": "range",
        "id": "thickness",
        "label": "t:settings.thickness",
        "min": 0.5,
        "max": 5,
        "step": 0.5,
        "unit": "px",
        "default": 1
      },
      {
        "type": "select",
        "id": "corner_radius",
        "label": "t:settings.border_radius",
        "options": [
          {
            "value": "square",
            "label": "t:options.square"
          },
          {
            "value": "rounded",
            "label": "t:options.rounded"
          }
        ],
        "default": "square",
        "visible_if": "{{ section.settings.thickness > 1 and section.settings.width_percent != 100 or section.settings.section_width == \"page-width\"}}"
      },
      {
        "type": "range",
        "id": "width_percent",
        "label": "t:settings.length",
        "min": 5,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "alignment_horizontal",
        "label": "t:settings.alignment",
        "options": [
          {
            "value": "flex-start",
            "label": "t:options.direction_start"
          },
          {
            "value": "center",
            "label": "t:options.direction_center"
          },
          {
            "value": "flex-end",
            "label": "t:options.direction_end"
          }
        ],
        "default": "center",
        "visible_if": "{{ section.settings.width_percent < 100 }}"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ],
    "presets": [
      {
        "name": "t:names.divider_section",
        "category": "t:categories.layout"
      }
    ]
  }
}
</schema>
