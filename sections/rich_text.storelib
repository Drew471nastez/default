<template compat="shopify">
{% render 'contrast-override', color_scheme: section.settings.color_scheme, use_theme_default: true, section_id: section.id %}
<div class="section-background color-custom-{{ section.id }}"></div>
<section
  class="section section--page-width color-custom-{{ section.id }} policy-rich-text"
  style="
    --policy-padding-top: {{ section.settings.padding_top }}px;
    --policy-padding-bottom: {{ section.settings.padding_bottom }}px;
    --policy-text-align: {{ section.settings.alignment }};
    --policy-max-width: {% if section.settings.max_width == 'narrow' %}var(--narrow-content-width){% elsif section.settings.max_width == 'normal' %}var(--normal-content-width){% else %}100%{% endif %};
  "
>
  <div class="policy-rich-text__content">
    {% if section.settings.heading != blank %}
      {% if section.settings.heading_tag == 'h2' %}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {% else %}
        <h1 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h1>
      {% endif %}
    {% endif %}
    <div class="rte">{{ section.settings.body }}</div>
  </div>
</section>
{% stylesheet %}
  .policy-rich-text {
    padding-block: var(--policy-padding-top) var(--policy-padding-bottom);
    text-align: var(--policy-text-align);
  }

  .policy-rich-text__content {
    width: 100%;
    max-width: var(--policy-max-width);
    min-width: 0;
    margin-inline: auto;
    overflow-wrap: anywhere;
  }

  .policy-rich-text__content > :is(h1, h2) {
    margin-block: 0 var(--gap-lg);
  }
{% endstylesheet %}
</template>

<schema>
{
  "type": "rich_text",
  "name": "Policy and rich text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "Page heading"
        },
        {
          "value": "h2",
          "label": "Section heading"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading typography",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Default"
        },
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "none",
          "label": "Full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Policy and rich text"
    }
  ],
