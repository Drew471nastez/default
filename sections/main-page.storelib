<template compat="shopify">


{% liquid
    render 'contrast-override', color_scheme: section.settings.theme_color_scheme, use_theme_default: true, text_color: section.settings.text_color, background_color: section.settings.background_color, section_id: section.id
%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>
<div class="section page-width-content color-custom-{{ section.id }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>



</template>

<schema>
{
  "type": "main-page",
  "name": "Page",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "Direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "inherit",
          "label": "Theme"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit",
      "info": "Follow the site colors, or choose your own background and text."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "icon"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "accordion"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "email-signup"
    },
    {
      "type": "contact-form"
    },
    {
      "type": "page-content"
    }
  ],
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "shopify": {
    "name": "t:names.page",
    "class": "section-wrapper",
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "_divider"
      },
      {
        "type": "text"
      },
      {
        "type": "image"
      },
      {
        "type": "button"
      },
      {
        "type": "icon"
      },
      {
        "type": "video"
      },
      {
        "type": "group"
      },
      {
        "type": "spacer"
      },
      {
        "type": "accordion"
      },
      {
        "type": "custom-liquid"
      },
      {
        "type": "email-signup"
      },
      {
        "type": "contact-form"
      },
      {
        "type": "page-content"
      }
    ],
    "disabled_on": {
      "groups": [
        "header"
      ]
    },
    "settings": [
      {
        "type": "select",
        "id": "content_direction",
        "label": "t:settings.direction",
        "options": [
          {
            "value": "column",
            "label": "t:options.vertical"
          }
        ],
        "default": "column",
        "visible_if": "{{ section.settings.gap < 0 }}"
      },
      {
        "type": "range",
        "id": "gap",
        "label": "Space between items",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "select",
        "id": "theme_color_scheme",
        "label": "Colors",
        "options": [
          {
            "value": "inherit",
            "label": "Theme"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "inherit",
        "info": "Follow the site colors, or choose your own background and text."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "placeholder": "t:settings.default",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ]
  }
}
</schema>
