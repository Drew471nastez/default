<template compat="shopify">


{% liquid
  if section.settings.theme_color_scheme == 'surface' or section.settings.theme_color_scheme == 'inverse' or section.settings.theme_color_scheme == 'accent' or section.settings.background_color != blank
    render 'contrast-override', color_scheme: section.settings.theme_color_scheme, background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.theme_color_scheme == 'surface' or section.settings.theme_color_scheme == 'inverse' or section.settings.theme_color_scheme == 'accent' or section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.theme_color_scheme == 'surface' or section.settings.theme_color_scheme == 'inverse' or section.settings.theme_color_scheme == 'accent' or section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>



</template>

<schema>
{
  "type": "main-page",
  "name": "Page",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "Direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "shopify": {
    "name": "t:names.page",
    "class": "section-wrapper",
    "blocks": [
      {
        "type": "@theme"
      },
      {
        "type": "@app"
      },
      {
        "type": "_divider"
      }
    ],
    "disabled_on": {
      "groups": [
        "header"
      ]
    },
    "settings": [
      {
        "type": "select",
        "id": "content_direction",
        "label": "t:settings.direction",
        "options": [
          {
            "value": "column",
            "label": "t:options.vertical"
          }
        ],
        "default": "column",
        "visible_if": "{{ section.settings.gap < 0 }}"
      },
      {
        "type": "range",
        "id": "gap",
        "label": "t:settings.gap",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "select",
        "id": "theme_color_scheme",
        "label": "Color scheme",
        "options": [
          {
            "value": "inherit",
            "label": "Default / custom colors"
          },
          {
            "value": "surface",
            "label": "Soft surface"
          },
          {
            "value": "inverse",
            "label": "Inverse"
          },
          {
            "value": "accent",
            "label": "Accent"
          }
        ],
        "default": "inherit",
        "info": "Shared colors are edited in Theme settings → Colors. Default keeps the existing custom colors."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "t:settings.background_color",
        "placeholder": "t:settings.default"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ]
  }
}
</schema>
