        "default": false,
        "info": "Shown at the end of the bar when the store has more than one country."
      },
      {
        "type": "checkbox",
        "id": "show_language",
        "label": "Language",
        "default": false,
        "info": "Shown at the end of the bar when the store has more than one language."
      },
      {
        "type": "header",
        "content": "t:content.appearance"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Content width",
        "options": [
          {
