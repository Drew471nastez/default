<template compat="shopify">


{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', color_scheme: section.settings.theme_color_scheme, use_theme_default: true, text_color: section.settings.text_color, background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign show_language = section.settings.show_language
    if localization.available_languages.size <= 1
      assign show_language = false
    endif
    assign show_country = section.settings.show_country
    if localization.available_countries.size <= 1
      assign show_country = false
    endif
  %}
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>

  {% if show_country or show_language %}
    <dropdown-localization-component class="announcement-bar__localization dropdown-localization">
      <button
        type="button"
        class="button button-unstyled announcement-bar__localization-button dropdown-localization__button localization-selector"
        aria-expanded="false"
        aria-controls="announcement-localization-{{ section.id }}"
        ref="button"
        on:click="/toggleSelector"
      >
        {% if show_country %}
          <span
            class="icon-flag"
            style="background-image: url({{- localization.country | image_url: width: 32 }});"
          ></span>
          <span class="currency-code">{{ localization.country.currency.iso_code }}</span>
        {% endif %}
        {% if show_country and show_language %}
          <span aria-hidden="true">/</span>
        {% endif %}
        {% if show_language %}
          <span>{{ localization.language.iso_code | upcase }}</span>
        {% endif %}
        <span class="svg-wrapper icon-caret">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div
        id="announcement-localization-{{ section.id }}"
        class="localization-wrapper right-bound color-custom-popover"
        hidden
        ref="panel"
      >
        {% render 'localization-form',
          show_country: show_country,
          show_language: show_language,
          localization_style: 'dropdown',
          form_id: section.id
        %}
      </div>
    </dropdown-localization-component>
  {% endif %}
</aside>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .announcement-bar__localization {
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  .announcement-bar__localization-button {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.8125rem;
    line-height: 1;
  }

  .announcement-bar__localization .icon-flag {
    width: 18px;
    height: 12px;
    border-radius: 2px;
    background-position: center;
    background-size: cover;
    box-shadow: 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.16);
  }

  .announcement-bar__localization .localization-wrapper {
    position: absolute;
    inset-inline-end: 8px;
    top: calc(100% + 6px);
    width: min(22rem, calc(100vw - 24px));
    max-height: min(70vh, 28rem);
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__localization-button {
      padding-inline: 4px;
    }
  }

  .announcement-bar__slider {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}



</template>

<schema>
{
  "type": "header-announcements",
  "name": "Announcement bar",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Time to next announcement",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Country and currency",
      "default": false,
      "info": "Shown at the end of the bar when the store has more than one country."
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Language",
      "default": false,
      "info": "Shown at the end of the bar when the store has more than one language."
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "theme_color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "inherit",
          "label": "Theme"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit",
      "info": "Follow the site colors, or choose your own background and text."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.theme_color_scheme == 'custom' }}"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": [
        "announcement_1"
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "shopify": {
    "name": "t:names.announcement_bar",
    "blocks": [
      {
        "type": "_announcement"
      }
    ],
    "enabled_on": {
      "groups": [
        "header"
      ]
    },
    "settings": [
      {
